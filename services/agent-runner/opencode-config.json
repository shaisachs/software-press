{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "sp-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://ollama:11434/v1",
        "requestTimeout": -1,
        "socketTimeout": -1,
        "apiKey": "ollama"
      },
      "models": {
        "llama3.1:8b": {
          "name": "Llama 3.1"
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5"
        },
        "llama3.2:3b": {
          "name": "Llama 3.2"
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow"
  },
  "autoupdate": false
}