{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "sp-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://ollama:11434/v1",
        "requestTimeout": -1,
        "socketTimeout": -1,
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5:0.5b": {
          "name": "Qwen 2.5"
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "curl": "allow",
    "external_directory": {
      "/tmp/**": "allow"
    }
  },
  "autoupdate": false
}